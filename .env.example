# Neon PostgreSQL connection string. All credentials are SERVER ONLY.
DATABASE_URL=
# Authorized Walrus Memory DELEGATE private key. Never the owner/spending key.
MEMWAL_PRIVATE_KEY=
# MemWalAccount object ID, not delegate identity.
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
# Public delegate identity from dashboard, only for submission proof (optional).
MEMWAL_AGENT_ID=
TATUM_API_KEY=
# Optional, never needed by the deterministic agent.
OPENAI_API_KEY=
# Generate with openssl rand -hex 32; changing it invalidates sessions.
AUTH_SECRET=
# Strong owner login password (at least 16 characters).
OWNER_PASSWORD=
APP_URL=http://localhost:3000
# Anonymous writes are deliberately disabled; public demo is read-only.
GUEST_LIVE_WRITES=false
MEMORY_WRITES_PER_HOUR=24
# Shared sponsored account guard across all authenticated users (maximum 100).
MEMORY_GLOBAL_WRITES_PER_HOUR=40
RPC_REQUESTS_PER_HOUR=120
# Quote mode: false disables quotes; mainnet is the final target, testnet is development only.
# Neither mode alone enables signing or settlement.
ENABLE_AGENT_PAYMENTS=false
# Quotes support mainnet or testnet. Mainnet is implemented; this does not enable spending.
# Keep settlement disabled until security review and exact owner authorization.
SERVICE_PAYMENT_SETTLEMENT_ENABLED=false
# Dedicated public payer address required for Mainnet approval. Never a private key.
SERVICE_PAYMENT_PAYER=
# A separately controlled service merchant public address; no spending key.
SERVICE_PAYMENT_RECIPIENT=
# Optional persistent PostgreSQL WASM for LOCAL QA only; NEVER on Vercel.
# Production and live Mainnet workflows require DATABASE_URL (Neon).
LOCAL_DATABASE_PATH=
# Optional real public Sui digest for read-only live diagnostics; no fixture default.
TATUM_TEST_DIGEST=
# Tatum transport is fixed to native TLS gRPC at sui-mainnet-grpc.gateway.tatum.io:443.
# No browser-accessible API key, arbitrary provider URL or JSON-RPC fallback.

{
  "name": "payguard-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --conditions=react-server --import tsx scripts/migrate.ts",
    "db:seed-demo": "node --conditions=react-server --import tsx scripts/seed.ts",
    "proof:export": "node --conditions=react-server --import tsx scripts/proof.ts",
    "check:live": "node --conditions=react-server --import tsx scripts/check-live.ts",
    "memory:seed": "node --conditions=react-server --import tsx scripts/seed-memory.ts",
    "memory:prove-recall": "node --conditions=react-server --import tsx scripts/recall-proof.ts",
    "format": "prettier --write src scripts tests docs README.md CONTRIBUTING.md *.config.* package.json",
    "format:check": "prettier --check src scripts tests docs README.md CONTRIBUTING.md *.config.* package.json",
    "memory:expand": "node --conditions=react-server --import tsx scripts/expand-memory.ts",
    "judge:evidence": "node --conditions=react-server --import tsx scripts/judge-evidence.ts",
    "memory:evaluate": "node --conditions=react-server --import tsx scripts/evaluate-memory.ts",
    "judge:publish-build": "node scripts/build-judge-pages.mjs",
    "memory:preflight": "node --conditions=react-server --import tsx scripts/memory-preflight.ts",
    "memory:evaluate-learning": "node --conditions=react-server --import tsx scripts/evaluate-learning.ts",
    "test:e2e:isolated": "node scripts/run-isolated-e2e.mjs"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.8",
    "@grpc/grpc-js": "^1.14.6",
    "@mysten-incubation/memwal": "0.1.10",
    "@mysten/dapp-kit-core": "^1.6.41",
    "@mysten/dapp-kit-react": "^2.1.43",
    "@mysten/seal": "1.5.2",
    "@mysten/sui": "2.38.0",
    "@neondatabase/serverless": "^1.0.2",
    "@protobuf-ts/grpc-transport": "^2.11.1",
    "@wallet-standard/app": "^1.1.1",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.548.0",
    "motion": "^12.23.24",
    "next": "^16.0.0",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^22.18.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "drizzle-kit": "^0.31.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "type": "module"
}
